{
  "include": ["src", "tests"],
  "exclude": ["**/__pycache__"],
  "pythonVersion": "3.13",
  "venvPath": ".",
  "venv": ".venv",
  "typeCheckingMode": "standard",
  "reportMissingTypeStubs": false,
  "reportMissingModuleSource": false,
  "reportExplicitAny": "error",
  "reportPrivateUsage": "error",
  "executionEnvironments": [
    {
      "root": "tests",
      "reportPrivateUsage": "none"
    }
  ]
}
